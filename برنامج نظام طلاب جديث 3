// ==========================================
// Display Students Above Specific Grade
// ==========================================
void DisplayStudentsAboveGrade(
    const multimap<string, pair<int, int>>& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }
    cout << "\nEnter Minimum Grade: ";
    int MinimumGrade = GetValidMark();
    bool Found = false;
    cout << "\n=====================================\n";
    cout << "Students With Grade >= " << MinimumGrade  << "\n";
    cout << "=====================================\n";
    for (auto Val : Map)
    {
        int Mark = Val.second.second;
        if (Mark >= MinimumGrade)
        {
            cout << Val.first
                 << " | ID: " << Val.second.first  << " | Mark: "
                 << Mark << " | Grade: " << GetGradeName(Mark)
                 << " | Letter: " << GetLetterGrade(Mark)  << "\n";
            Found = true;
        }
    }
    if (!Found)
    {
        cout << "No Students Found.\n";
    }
}
// ==========================================
// Display Students With Highest Grade
// ==========================================
void DisplayHighestStudents(
    const multimap<string, pair<int, int>>& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }
    int MaxGrade = -1;
    // Find Highest Grade
    for (auto Val : Map)
    {
        int Mark = Val.second.second;
        if (Mark > MaxGrade)
            MaxGrade = Mark;
    }
    cout << "\n=====================================\n";
    cout << "       Students With Highest Grade\n";
    cout << "=====================================\n";
    cout << "Highest Grade: " << MaxGrade << "\n\n";
    // Display all students
    // who have the highest grade
    for (auto Val : Map)
    {
        int Mark = Val.second.second;
        if (Mark == MaxGrade)
        {
            cout << "Name: "  << Val.first  << " | ID: "
                 << Val.second.first
                 << " | Mark: " << Mark << " | Grade: "
                 << GetGradeName(Mark)
                 << " | Letter: " << GetLetterGrade(Mark)  << "\n";
        }
    }
}
