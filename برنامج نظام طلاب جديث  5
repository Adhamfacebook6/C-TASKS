void DisplayAllStudents(const StudentMap& Map)
{
    if (!HasStudents(Map))
    {
        return;
    }

    PrintHeader("All Students");
    for (const auto& [Id, S] : Map)
    {
        PrintDetailedLine(S);
    }
}

void SearchStudentById(const StudentMap& Map)
{
    const int Id = GetValidId();
    const auto It = Map.find(Id);
    if (It == Map.end())
    {
        cout << "\nStudent With ID " << Id << " Not Found.\n";
        return;
    }

    PrintHeader("Student Found");
    PrintStudent(cout, It->second);
}

void SearchByName(const StudentMap& Map)
{
    const string Query = GetStudentName("\nEnter Student Name (Or Part Of It): ");
    const vector<int> Ids = FindIdsByName(Map, Query);

    if (Ids.empty())
    {
        cout << "Student Not Found.\n";
        return;
    }

    PrintHeader("Students Matching: " + Query);
    for (int Id : Ids)
    {
        PrintStudent(cout, Map.at(Id));
        cout << SEPARATOR << "\n";
    }
}

void SearchByMarkRange(const StudentMap& Map)
{
    if (!HasStudents(Map))
    {
        return;
    }

    int Minimum = GetValidMark("\nEnter Minimum Mark (0 - 1000): ");
    int Maximum = GetValidMark("Enter Maximum Mark (0 - 1000): ");
    if (Minimum > Maximum)
    {
        swap(Minimum, Maximum);
    }

    DisplayFiltered(
        "Students Between " + to_string(Minimum) + " And " + to_string(Maximum),
        Map,
        [Minimum, Maximum](const Student& S)
        {
            return S.Mark >= Minimum && S.Mark <= Maximum;
        });
}

void SortStudentsByMark(const StudentMap& Map)
{
    if (!HasStudents(Map))
    {
        return;
    }

    cout << "\n1. Highest To Lowest\n"
            "2. Lowest To Highest\n";
    const int Choice = GetValidInteger("Enter Choice: ");
    if (Choice != 1 && Choice != 2)
    {
        cout << "Invalid Choice.\n";
        return;
    }

    PrintHeader("Students Sorted By Mark");
    for (const Student& S : SortedByMark(Map, Choice == 1))
    {
        PrintLine(S);
    }
}

void DisplayStudentsAboveGrade(const StudentMap& Map)
{
    const int MinimumMark = GetValidMark("Enter Minimum Mark (0 - 1000): ");
    DisplayFiltered("Students With Mark >= " + to_string(MinimumMark), Map,
                    [MinimumMark](const Student& S) { return S.Mark >= MinimumMark; },
                    true);
}

// ============================================================
// File Operations
// ============================================================
void SaveToFile(const StudentMap& Map)
{
    ofstream File(SAVE_FILE);
    if (!File)
    {
        cout << "\nError Opening File!\n";
        return;
    }

    for (const auto& [Id, S] : Map)
    {
        File << S.Name << FIELD_SEPARATOR << S.Id << FIELD_SEPARATOR << S.Mark << "\n";
    }
    cout << "\nData Saved Successfully To " << SAVE_FILE << "\n";
}

// Parses one "Name|Id|Mark" line. Returns false if the line is invalid.
bool ParseStudentLine(const string& Line, Student& Result)
{
    const size_t Last = Line.rfind(FIELD_SEPARATOR);
    if (Last == string::npos || Last == 0)
    {
        return false;
    }

    const size_t Middle = Line.rfind(FIELD_SEPARATOR, Last - 1);
    if (Middle == string::npos)
    {
        return false;
    }

    try
    {
        Result.Name = Line.substr(0, Middle);
        Result.Id = stoi(Line.substr(Middle + 1, Last - Middle - 1));
        Result.Mark = stoi(Line.substr(Last + 1));
    }
    catch (const exception&)
    {
        return false;
    }

    return !Result.Name.empty() && Result.Id > 0 &&
           Result.Mark >= 0 && Result.Mark <= MAX_MARK;
}

// Loads into a temporary map first, so the current data is only replaced
// when the file could actually be read.
bool LoadFromFile(StudentMap& Map)
{
    ifstream File(SAVE_FILE);
    if (!File)
    {
        cout << "\nNo Save File Found.\n";
        return false;
    }

    StudentMap Loaded;
    int Skipped = 0;
    string Line;

    while (getline(File, Line))
    {
        if (Line.empty())
        {
            continue;
        }

        Student S;
        if (ParseStudentLine(Line, S) && !IsIdExists(Loaded, S.Id))
        {
            Loaded[S.Id] = S;
        }
        else
        {
            ++Skipped;
        }
    }

    Map = move(Loaded);

    cout << "\nData Loaded Successfully (" << Map.size() << " Students";
    if (Skipped > 0)
    {
        cout << ", " << Skipped << " Invalid Line(s) Skipped";
    }
    cout << ").\n";
    return true;
}

void ExportReport(const StudentMap& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students To Export.\n";
        return;
    }

    ofstream File(REPORT_FILE);
    if (!File)
    {
        cout << "\nError Creating Report File!\n";
        return;
    }

    PrintBanner(File, "STUDENT MANAGEMENT REPORT");
    File << "\n";
    PrintStats(File, CalculateStats(Map));

    File << "\n";
    PrintBanner(File, "STUDENTS");
    File << "\n";
    for (const auto& [Id, S] : Map)
    {
        PrintStudent(File, S);
        File << SEPARATOR << "\n";
    }

    cout << "\nReport Exported Successfully To " << REPORT_FILE << "\n";
}

