            "9.  Sort Students By Mark\n"
            "10. Students Above Specific Grade\n"
            "11. Statistics Menu\n"
            "12. Save Data\n"
            "13. Load Data\n"
            "14. Export Report\n"
            "0.  Exit\n"
         << string(BANNER_WIDTH, '=') << "\n";
}
// Returns false when the user chooses to exit.
bool HandleMainMenuChoice(int Choice, StudentMap& Map)
{
    switch (Choice)
    {
        case 1: DisplayAllStudents(Map); break;
        case 2: AddStudent(Map); break;
        case 3: SearchByName(Map); break;
        case 4: SearchStudentById(Map); break;
        case 5: SearchByMarkRange(Map); break;
        case 6: UpdateStudent(Map); break;
        case 7: DeleteStudent(Map); break;
        case 8: DeleteByName(Map); break;
        case 9: SortStudentsByMark(Map); break;
        case 10: DisplayStudentsAboveGrade(Map); break;
        case 11: StatisticsMenu(Map); break;
        case 12: SaveToFile(Map); break;
        case 13:
            if (Confirm("Loading Will Replace Current Data. Continue?"))
            {
                LoadFromFile(Map);
            }
            break;
        case 14: ExportReport(Map); break;
        case 0:
            if (Confirm("Save Data Before Exit?"))
            {
                SaveToFile(Map);
            }
            cout << "\nProgram Ended.\n";
            return false;
        default: cout << "\nInvalid Choice!\n";
    }
    return true;
}
// ============================================================
// Startup
// ============================================================
void ReadInitialStudents(StudentMap& Map)
{
    const int Count = GetValidPositiveNumber("\nEnter Number Of Students: ");
    for (int i = 1; i <= Count; ++i)
    {
        PrintHeader("Student " + to_string(i));
        const Student S = ReadNewStudent(Map);
        Map[S.Id] = S;
    }
}
int main()
{
    StudentMap Map;
    PrintBanner(cout, "Student Management System");
    cout << "\nDo You Want To Load Saved Data?\n"
            "1. Yes\n"
            "0. No\n";
    if (GetValidInteger("Enter Choice: ") == 1)
    {
        LoadFromFile(Map);
    }

    if (Map.empty())
    {
        ReadInitialStudents(Map);
    }
    do
    {
        PrintMainMenu();
    } while (HandleMainMenuChoice(GetValidInteger("Enter Your Choice: "), Map));
    return 0;
}
