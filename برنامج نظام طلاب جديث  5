void StatisticsMenu(const StudentMap& Map)
{
    while (true)
    {
        PrintHeader("Statistics Menu");
        cout << "1. Advanced Statistics\n"
                "2. Highest / Lowest Per Grade\n"
                "3. Top N Students\n"
                "4. Lowest N Students\n"
                "5. Highest Grade Students\n"
                "6. Passed Students\n"
                "7. Failed Students\n"
                "0. Back\n";

        switch (GetValidInteger("Enter Choice: "))
        {
            case 1: ShowAdvancedStatistics(Map); break;
            case 2: HighestLowestEachGrade(Map); break;
            case 3: DisplayTopOrBottomN(Map, true); break;
            case 4: DisplayTopOrBottomN(Map, false); break;
            case 5: DisplayHighestStudents(Map); break;
            case 6:
                DisplayFiltered("Passed Students", Map,
                                [](const Student& S) { return IsPassed(S.Mark); });
                break;
            case 7:
                DisplayFiltered("Failed Students", Map,
                                [](const Student& S) { return !IsPassed(S.Mark); });
                break;
            case 0: return;
            default: cout << "Invalid Choice!\n";
        }
    }
}

