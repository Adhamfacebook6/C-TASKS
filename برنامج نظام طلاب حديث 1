    for (auto Val : Students)
    {
        int Id = Val.first;
        string Name = Val.second.first;
        int Mark = Val.second.second;

        if (Mark == MaxGrade)
        {
            cout << "ID: " << Id
                 << " | Name: " << Name
                 << " | Mark: " << Mark
                 << " | Grade: "
                 << GetGradeName(Mark)
                 << " | Letter: "
                 << GetLetterGrade(Mark)
