    const map<int, pair<string, int>>& Students)
{
    if (Students.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }

    int MaxGrade = -1;

    // Find Maximum Grade
    for (auto Val : Students)
    {
        int Mark = Val.second.second;

        if (Mark > MaxGrade)
        {
            MaxGrade = Mark;
        }
    }

    cout << "\n=====================================\n";
    cout << "       Students With Highest Grade\n";
    cout << "=====================================\n";

    cout << "Highest Grade: "
         << MaxGrade << "\n\n";

    // Display all students
