#include <iostream>
#include <map>
#include <string>
#include <iomanip>
using namespace std;
// ==========================================
// Get Grade Name
// ==========================================
string GetGradeName(int Mark)
{
    if (Mark >= 900)
        return "Excellent";
    else if (Mark >= 850)
        return "Very Good";
    else if (Mark >= 700)
        return "Good";
    else if (Mark >= 550)
        return "Pass";
    else
        return "Fail";
}

// ==========================================
// Get Letter Grade
// ==========================================
char GetLetterGrade(int Mark)
{
    if (Mark >= 900)
        return 'A';
    else if (Mark >= 850)
        return 'B';
    else if (Mark >= 700)
        return 'C';
    else if (Mark >= 550)
        return 'D';
    else
        return 'F';
}
// ==========================================
// Get Valid Mark
// ==========================================
int GetValidMark()
{
    int Mark;
    while (true)
    {
        cin >> Mark;

        if (Mark >= 0 && Mark <= 1000)
        {
            return Mark;
        }
        cout << "Invalid Mark!\n";
        cout << "Please Enter Mark Between 0 And 1000: ";
    }
}

// ==========================================
// Display Student
// ==========================================
void DisplayStudent(
    int Id,
    const string& Name,
    int Mark)
{
    cout << "Name: " << Name << "\n";
    cout << "ID: " << Id << "\n";
    cout << "Mark: " << Mark << "\n";

    cout << "Percentage: "
         << static_cast<double>(Mark) / 1000 * 100
         << "%\n";

    cout << "Grade: "
         << GetGradeName(Mark)
         << "\n";

    cout << "Letter Grade: "
         << GetLetterGrade(Mark)
         << "\n";
}

// ==========================================
// Display All Students
// ==========================================
void DisplayAllStudents(
    const map<int, pair<string, int>>& Students)
{
    if (Students.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }

    cout << "\n=====================================\n";
    cout << "          All Students\n";
    cout << "=====================================\n";

    for (auto Val : Students)
    {
        int Id = Val.first;
        string Name = Val.second.first;
        int Mark = Val.second.second;

        cout << "ID: " << Id
             << " | Name: " << Name
             << " | Mark: " << Mark
             << " | Grade: " << GetGradeName(Mark)
             << " | Letter: " << GetLetterGrade(Mark)
             << " | Percentage: "
             << static_cast<double>(Mark) / 1000 * 100
             << "%\n";
    }
}

// ==========================================
// Add Student
// ==========================================
void AddStudent(
    map<int, pair<string, int>>& Students)
{
    int Id;
    string Name;
    int Mark;

    cout << "\nEnter Student ID: ";
    cin >> Id;

    // map automatically checks ID
    if (Students.find(Id) != Students.end())
    {
        cout << "This ID Already Exists!\n";
        return;
    }

    cout << "Enter Student Name: ";
    cin >> Name;

    cout << "Enter Student Mark (0 - 1000): ";
    Mark = GetValidMark();

    Students[Id] = {Name, Mark};

    cout << "\nStudent Added Successfully!\n";
}

// ==========================================
// Search By ID
// ==========================================
void SearchById(
    const map<int, pair<string, int>>& Students)
{
    int SearchId;

    cout << "\nEnter Student ID: ";
    cin >> SearchId;

    auto It = Students.find(SearchId);

    if (It == Students.end())
    {
        cout << "\nStudent Not Found.\n";
        return;
    }

    int Id = It->first;
    string Name = It->second.first;
    int Mark = It->second.second;

    cout << "\n=====================================\n";
    cout << "          Student Found\n";
    cout << "=====================================\n";

    DisplayStudent(Id, Name, Mark);
}

// ==========================================
// Search By Name
// ==========================================
void SearchByName(
    const map<int, pair<string, int>>& Students)
{
    string SearchName;

    cout << "\nEnter Student Name: ";
    cin >> SearchName;

    bool Found = false;

    cout << "\n=====================================\n";
    cout << "Students With Name: "
         << SearchName << "\n";
    cout << "=====================================\n";

    for (auto Val : Students)
    {
        int Id = Val.first;
        string Name = Val.second.first;
        int Mark = Val.second.second;

        if (Name == SearchName)
        {
            DisplayStudent(Id, Name, Mark);

            cout << "-------------------------------------\n";

            Found = true;
        }
    }

    if (!Found)
    {
        cout << "Student Not Found.\n";
    }
}

// ==========================================
// Update Student
// ==========================================
void UpdateStudent(
    map<int, pair<string, int>>& Students)
{
    int Id;

    cout << "\nEnter Student ID To Update: ";
    cin >> Id;

    auto It = Students.find(Id);

    if (It == Students.end())
    {
        cout << "\nStudent Not Found.\n";
        return;
    }

    cout << "\nCurrent Student Data:\n";

    DisplayStudent(
        It->first,
        It->second.first,
        It->second.second
    );

    string NewName;
    int NewMark;

    cout << "\nEnter New Name: ";
    cin >> NewName;

    cout << "Enter New Mark (0 - 1000): ";
    NewMark = GetValidMark();

    It->second.first = NewName;
    It->second.second = NewMark;

    cout << "\nStudent Updated Successfully!\n";
}

// ==========================================
// Delete Student
// ==========================================
void DeleteStudent(
    map<int, pair<string, int>>& Students)
{
    int Id;

    cout << "\nEnter Student ID To Delete: ";
    cin >> Id;

    auto It = Students.find(Id);

    if (It == Students.end())
    {
        cout << "\nStudent Not Found.\n";
        return;
    }

    cout << "\nStudent To Delete:\n";

    DisplayStudent(
        It->first,
        It->second.first,
        It->second.second
    );

    Students.erase(It);

    cout << "\nStudent Deleted Successfully!\n";
}

// ==========================================
// Statistics
// ==========================================
void ShowStatistics(
    const map<int, pair<string, int>>& Students)
{
    if (Students.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }

    int Sum = 0;

    int Passed = 0;
    int Failed = 0;

    int MaxGrade = -1;
    int MinGrade = 1001;

    int ExcellentCount = 0;
    int VeryGoodCount = 0;
    int GoodCount = 0;
    int PassCount = 0;
    int FailCount = 0;

    for (auto Val : Students)
    {
        int Mark = Val.second.second;

        Sum += Mark;

        if (Mark > MaxGrade)
            MaxGrade = Mark;

        if (Mark < MinGrade)
            MinGrade = Mark;

        // Passed / Failed
        if (Mark >= 400)
            ++Passed;
        else
            ++Failed;

        // Count Grades
        if (Mark >= 900)
            ++ExcellentCount;
        else if (Mark >= 850)
            ++VeryGoodCount;
        else if (Mark >= 700)
            ++GoodCount;
        else if (Mark >= 550)
            ++PassCount;
        else
            ++FailCount;
    }

    int Counter = Students.size();

    double Average =
        static_cast<double>(Sum) / Counter;

    double PassRate =
        static_cast<double>(Passed) / Counter * 100;

    double FailRate =
        static_cast<double>(Failed) / Counter * 100;

    cout << "\n=====================================\n";
    cout << "             Statistics\n";
    cout << "=====================================\n";

    cout << "Total Students: "
         << Counter << "\n";

    cout << "Total Grades: "
         << Sum << "\n";

    cout << "Average Grade: "
         << Average << "\n";

    cout << "Highest Grade: "
         << MaxGrade << "\n";

    cout << "Lowest Grade: "
         << MinGrade << "\n";

    cout << "Passed Students: "
         << Passed << "\n";

    cout << "Failed Students: "
         << Failed << "\n";

    cout << fixed << setprecision(2);

    cout << "Success Percent: "
         << PassRate << "%\n";

    cout << "Failing Percent: "
         << FailRate << "%\n";

    cout << "\nNumber Of Students In Each Grade:\n";

    cout << "Excellent: "
         << ExcellentCount << "\n";

    cout << "Very Good: "
         << VeryGoodCount << "\n";

    cout << "Good: "
         << GoodCount << "\n";

    cout << "Pass: "
         << PassCount << "\n";

    cout << "Fail: "
         << FailCount << "\n";
}

// ==========================================
// Highest / Lowest Per Grade
// ==========================================
void HighestLowestEachGrade(
    const map<int, pair<string, int>>& Students)
{
    if (Students.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }

    int ExcellentMax = -1;
    int ExcellentMin = 1001;

    int VeryGoodMax = -1;
    int VeryGoodMin = 1001;

    int GoodMax = -1;
    int GoodMin = 1001;

    int PassMax = -1;
    int PassMin = 1001;

    int FailMax = -1;
    int FailMin = 1001;

    for (auto Val : Students)
    {
        int Mark = Val.second.second;

        if (Mark >= 900)
        {
            if (Mark > ExcellentMax)
                ExcellentMax = Mark;

            if (Mark < ExcellentMin)
                ExcellentMin = Mark;
        }
        else if (Mark >= 850)
        {
            if (Mark > VeryGoodMax)
                VeryGoodMax = Mark;

            if (Mark < VeryGoodMin)
                VeryGoodMin = Mark;
        }
        else if (Mark >= 700)
        {
            if (Mark > GoodMax)
                GoodMax = Mark;

            if (Mark < GoodMin)
                GoodMin = Mark;
        }
        else if (Mark >= 550)
        {
            if (Mark > PassMax)
                PassMax = Mark;

            if (Mark < PassMin)
                PassMin = Mark;
        }
        else
        {
            if (Mark > FailMax)
                FailMax = Mark;

            if (Mark < FailMin)
                FailMin = Mark;
        }
    }

    cout << "\n=====================================\n";
    cout << "     Highest / Lowest Per Grade\n";
    cout << "=====================================\n";

    if (ExcellentMax != -1)
    {
        cout << "Excellent -> Highest: "
             << ExcellentMax
             << " | Lowest: "
             << ExcellentMin << "\n";
    }
    else
    {
        cout << "Excellent -> No Students\n";
    }

    if (VeryGoodMax != -1)
    {
        cout << "Very Good -> Highest: "
             << VeryGoodMax
             << " | Lowest: "
             << VeryGoodMin << "\n";
    }
    else
    {
        cout << "Very Good -> No Students\n";
    }

    if (GoodMax != -1)
    {
        cout << "Good -> Highest: "
             << GoodMax
             << " | Lowest: "
             << GoodMin << "\n";
    }
    else
    {
        cout << "Good -> No Students\n";
    }

    if (PassMax != -1)
    {
        cout << "Pass -> Highest: "
             << PassMax
             << " | Lowest: "
             << PassMin << "\n";
    }
    else
    {
        cout << "Pass -> No Students\n";
    }

    if (FailMax != -1)
    {
        cout << "Fail -> Highest: "
             << FailMax
             << " | Lowest: "
             << FailMin << "\n";
    }
    else
    {
        cout << "Fail -> No Students\n";
    }
}

