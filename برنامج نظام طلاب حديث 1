}

// ==========================================
// Main
// ==========================================
int main()
{
    // ======================================
    // ID -> Name + Mark
    // ======================================

    map<int, pair<string, int>> Students;

    cout << "Enter Number Of Students: ";

    int Num;
    cin >> Num;

    if (Num <= 0)
    {
        cout << "Invalid Value!\n";
        return 0;
    }

    // ======================================
    // Initial Input
    // ======================================

    cout << "\nEnter Student Information\n";

    for (int i = 0; i < Num; ++i)
    {
        int Id;
        string Name;
        int Mark;

        cout << "\nStudent "
             << i + 1 << "\n";

        cout << "ID: ";
        cin >> Id;

        // Check Duplicate ID

        while (Students.find(Id) != Students.end())
        {
            cout << "This ID Already Exists!\n";

            cout << "Enter Another ID: ";

            cin >> Id;
        }

        cout << "Name: ";
        cin >> Name;

        cout << "Mark (0 - 1000): ";

        Mark = GetValidMark();

        Students[Id] = {
            Name,
            Mark
        };
    }

    // ======================================
    // Main Menu
    // ======================================

    while (true)
    {
        cout << "\n\n";

        cout << "=====================================\n";
        cout << "      Student Management System\n";
        cout << "=====================================\n";

        cout << "1. Display All Students\n";
        cout << "2. Add New Student\n";
        cout << "3. Search By Name\n";
        cout << "4. Search By ID\n";
        cout << "5. Update Student\n";
        cout << "6. Delete Student\n";
        cout << "7. Show Statistics\n";
        cout << "8. Highest / Lowest Per Grade\n";
        cout << "9. Show Passed Students\n";
        cout << "10. Show Failed Students\n";
        cout << "11. Show Students Above Grade\n";
        cout << "12. Show Students With Highest Grade\n";
        cout << "0. Exit\n";

        cout << "=====================================\n";

        cout << "Enter Your Choice: ";

        int Choice;
        cin >> Choice;

        switch (Choice)
        {
            case 1:

                DisplayAllStudents(Students);

                break;

            case 2:

                AddStudent(Students);

                break;

            case 3:

                SearchByName(Students);

                break;

            case 4:

                SearchById(Students);

                break;

            case 5:

                UpdateStudent(Students);

                break;

            case 6:

                DeleteStudent(Students);

                break;

            case 7:

                ShowStatistics(Students);

                break;

            case 8:

                HighestLowestEachGrade(Students);

                break;

            case 9:

                DisplayPassedStudents(Students);

                break;

            case 10:

                DisplayFailedStudents(Students);

                break;

            case 11:

                DisplayStudentsAboveGrade(Students);

                break;

            case 12:

                DisplayHighestStudents(Students);

                break;

            case 0:

                cout << "\nProgram Ended.\n";

                return 0;

            default:

                cout << "\nInvalid Choice!\n";
        }
    }

    return 0;
}
