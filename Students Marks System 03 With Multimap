// ==========================================
// Get Grade Name
// ==========================================
string GetGradeName(int Mark)
{
    if (Mark >= 900)
        return "Excellent";
    else if (Mark >= 850)
        return "Very Good";
    else if (Mark >= 700)
        return "Good";
    else if (Mark >= 550)
        return "Pass";
    else
        return "Fail";
}

// ==========================================
// Get Letter Grade
// ==========================================
char GetLetterGrade(int Mark)
{
    if (Mark >= 900)
        return 'A';
    else if (Mark >= 850)
        return 'B';
    else if (Mark >= 700)
        return 'C';
    else if (Mark >= 550)
        return 'D';
    else
        return 'F';
}

// ==========================================
// Get Valid Mark
// ==========================================
int GetValidMark()
{
    int Mark;

    while (true)
    {
        cin >> Mark;

        if (Mark >= 0 && Mark <= 1000)
        {
            return Mark;
        }

        cout << "Invalid Mark!\n";
        cout << "Please Enter Mark Between 0 And 1000: ";
    }
}

// ==========================================
// Check If ID Already Exists
// ==========================================
bool IsIdExists(
    const multimap<string, pair<int, int>>& Map,
    int SearchId)
{
    for (auto It = Map.begin(); It != Map.end(); ++It)
    {
        if (It->second.first == SearchId)
        {
            return true;
        }
    }

    return false;
}

// ==========================================
// Display One Student
// ==========================================
void DisplayStudent(
    const string& Name,
    int Id,
    int Mark)
{
    cout << "Name: " << Name << "\n";
    cout << "ID: " << Id << "\n";
    cout << "Mark: " << Mark << "\n";

    cout << "Percentage: "
         << static_cast<double>(Mark) / 1000 * 100
         << "%\n";

    cout << "Grade: "
         << GetGradeName(Mark)
         << "\n";

    cout << "Letter Grade: "
         << GetLetterGrade(Mark)
         << "\n";
}

// ==========================================
// Display All Students
// ==========================================
void DisplayAllStudents(
    const multimap<string, pair<int, int>>& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }

    cout << "\n=====================================\n";
    cout << "          All Students\n";
    cout << "=====================================\n";

    for (auto Val : Map)
    {
        string Name = Val.first;
        int Id = Val.second.first;
        int Mark = Val.second.second;

        cout << Name << " "
             << Id << " "
             << Mark << " "
             << GetGradeName(Mark)
             << " (" << GetLetterGrade(Mark) << ") "
             << "- "
             << static_cast<double>(Mark) / 1000 * 100
             << "%\n";
    }
}

// ==========================================
// Add New Student
// ==========================================
void AddStudent(
    multimap<string, pair<int, int>>& Map)
{
    string Name;
    int Id;

    cout << "\nEnter Student Name: ";
    cin >> Name;

    cout << "Enter Student ID: ";
    cin >> Id;

    if (IsIdExists(Map, Id))
    {
        cout << "This ID Already Exists!\n";
        return;
    }

    cout << "Enter Student Mark (0 - 1000): ";

    int Mark = GetValidMark();

    Map.insert({
        Name,
        {Id, Mark}
    });

    cout << "\nStudent Added Successfully!\n";
}

// ==========================================
// Search Student By ID
// ==========================================
bool SearchById(
    const multimap<string, pair<int, int>>& Map,
    int SearchId)
{
    for (auto It = Map.begin(); It != Map.end(); ++It)
    {
        if (It->second.first == SearchId)
        {
            cout << "\n=====================================\n";
            cout << "          Student Found\n";
            cout << "=====================================\n";

            DisplayStudent(
                It->first,
                It->second.first,
                It->second.second
            );

            return true;
        }
    }

    return false;
}

// ==========================================
// Search Student By Name
// ==========================================
void SearchByName(
    const multimap<string, pair<int, int>>& Map)
{
    string SearchName;

    cout << "\nEnter Student Name: ";
    cin >> SearchName;

    auto Range = Map.equal_range(SearchName);

    if (Range.first == Range.second)
    {
        cout << "Student Not Found\n";
        return;
    }

    cout << "\n=====================================\n";
    cout << "Students With Name: "
         << SearchName << "\n";
    cout << "=====================================\n";

    for (auto It = Range.first;
         It != Range.second;
         ++It)
    {
        DisplayStudent(
            It->first,
            It->second.first,
            It->second.second
        );

        cout << "-------------------------------------\n";
    }
}

// ==========================================
// Delete Student By ID
// ==========================================
void DeleteStudent(
    multimap<string, pair<int, int>>& Map)
{
    int DeleteId;

    cout << "\nEnter Student ID To Delete: ";
    cin >> DeleteId;

    for (auto It = Map.begin();
         It != Map.end();
         ++It)
    {
        if (It->second.first == DeleteId)
        {
            cout << "\nStudent Found:\n";

            DisplayStudent(
                It->first,
                It->second.first,
                It->second.second
            );

            Map.erase(It);

            cout << "\nStudent Deleted Successfully!\n";

            return;
        }
    }

    cout << "\nStudent Not Found!\n";
}

// ==========================================
// Update Student
// ==========================================
void UpdateStudent(
    multimap<string, pair<int, int>>& Map)
{
    int SearchId;

    cout << "\nEnter Student ID To Update: ";
    cin >> SearchId;

    for (auto It = Map.begin();
         It != Map.end();
         ++It)
    {
        if (It->second.first == SearchId)
        {
            string OldName = It->first;
            int OldId = It->second.first;
            int OldMark = It->second.second;

            cout << "\nCurrent Student Data:\n";

            DisplayStudent(
                OldName,
                OldId,
                OldMark
            );

            string NewName;
            int NewMark;

            cout << "\nEnter New Name: ";
            cin >> NewName;

            cout << "Enter New Mark (0 - 1000): ";
            NewMark = GetValidMark();

            // Delete old record
            Map.erase(It);

            // Insert updated record
            Map.insert({
                NewName,
                {OldId, NewMark}
            });

            cout << "\nStudent Updated Successfully!\n";

            return;
        }
    }

    cout << "\nStudent Not Found!\n";
}

// ==========================================
// Statistics
// ==========================================
void ShowStatistics(
    const multimap<string, pair<int, int>>& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }

    int Sum = 0;
    int Passed = 0;
    int Failed = 0;

    int MaxGrade = -1;
    int MinGrade = 1001;

    // Counters
    int ExcellentCount = 0;
    int VeryGoodCount = 0;
    int GoodCount = 0;
    int PassCount = 0;
    int FailCount = 0;

    for (auto Val : Map)
    {
        int Mark = Val.second.second;

        // Calculate total
        Sum += Mark;

        // Find highest grade
        if (Mark > MaxGrade)
            MaxGrade = Mark;

        // Find lowest grade
        if (Mark < MinGrade)
            MinGrade = Mark;

        // Pass / Fail
        // Passing starts from 550
        if (Mark >= 550)
            ++Passed;
        else
            ++Failed;

        // Count each grade
        if (Mark >= 900)
            ++ExcellentCount;
        else if (Mark >= 850)
            ++VeryGoodCount;
        else if (Mark >= 700)
            ++GoodCount;
        else if (Mark >= 550)
            ++PassCount;
        else
            ++FailCount;
    }

    int Counter = Map.size();

    double Average =
        static_cast<double>(Sum) / Counter;

    double PassRate =
        static_cast<double>(Passed) / Counter * 100;

    double FailRate =
        static_cast<double>(Failed) / Counter * 100;

    cout << "\n=====================================\n";
    cout << "             Statistics\n";
    cout << "=====================================\n";

    cout << "Total Students: "
         << Counter << "\n";

    cout << "Total Grades: "
         << Sum << "\n";

    cout << "Average Grade: "
         << Average << "\n";

    cout << "Highest Grade: "
         << MaxGrade << "\n";

    cout << "Lowest Grade: "
         << MinGrade << "\n";

    cout << "Passed Students: "
         << Passed << "\n";

    cout << "Failed Students: "
         << Failed << "\n";

    cout << fixed << setprecision(2);

    cout << "Success Percent: "
         << PassRate
         << "%\n";

    cout << "Failing Percent: "
         << FailRate
         << "%\n";

    cout << "\nNumber Of Students In Each Grade:\n";

    cout << "Excellent: "
         << ExcellentCount << "\n";

    cout << "Very Good: "
         << VeryGoodCount << "\n";

    cout << "Good: "
         << GoodCount << "\n";

    cout << "Pass: "
         << PassCount << "\n";

    cout << "Fail: "
         << FailCount << "\n";
}

// ==========================================
// Highest And Lowest Grade For Each Grade
// ==========================================
void HighestLowestEachGrade(
    const multimap<string, pair<int, int>>& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }

    int ExcellentMax = -1;
    int ExcellentMin = 1001;

    int VeryGoodMax = -1;
    int VeryGoodMin = 1001;

    int GoodMax = -1;
    int GoodMin = 1001;

    int PassMax = -1;
    int PassMin = 1001;

    int FailMax = -1;
    int FailMin = 1001;

    for (auto Val : Map)
    {
        int Mark = Val.second.second;

        if (Mark >= 900)
        {
            if (Mark > ExcellentMax)
                ExcellentMax = Mark;

            if (Mark < ExcellentMin)
                ExcellentMin = Mark;
        }
        else if (Mark >= 850)
        {
            if (Mark > VeryGoodMax)
                VeryGoodMax = Mark;

            if (Mark < VeryGoodMin)
                VeryGoodMin = Mark;
        }
        else if (Mark >= 700)
        {
            if (Mark > GoodMax)
                GoodMax = Mark;

            if (Mark < GoodMin)
                GoodMin = Mark;
        }
        else if (Mark >= 550)
        {
            if (Mark > PassMax)
                PassMax = Mark;

            if (Mark < PassMin)
                PassMin = Mark;
        }
        else
        {
            if (Mark > FailMax)
                FailMax = Mark;

            if (Mark < FailMin)
                FailMin = Mark;
        }
    }

    cout << "\n=====================================\n";
    cout << "     Highest / Lowest Per Grade\n";
    cout << "=====================================\n";

    if (ExcellentMax != -1)
        cout << "Excellent -> Highest: "
             << ExcellentMax
             << " | Lowest: "
             << ExcellentMin << "\n";
    else
        cout << "Excellent -> No Students\n";

    if (VeryGoodMax != -1)
        cout << "Very Good -> Highest: "
             << VeryGoodMax
             << " | Lowest: "
             << VeryGoodMin << "\n";
    else
        cout << "Very Good -> No Students\n";

    if (GoodMax != -1)
        cout << "Good -> Highest: "
             << GoodMax
             << " | Lowest: "
             << GoodMin << "\n";
    else
        cout << "Good -> No Students\n";

    if (PassMax != -1)
        cout << "Pass -> Highest: "
             << PassMax
             << " | Lowest: "
             << PassMin << "\n";
    else
        cout << "Pass -> No Students\n";

    if (FailMax != -1)
        cout << "Fail -> Highest: "
             << FailMax
             << " | Lowest: "
             << FailMin << "\n";
    else
        cout << "Fail -> No Students\n";
}

// ==========================================
// Display Passed Students
// ==========================================
void DisplayPassedStudents(
    const multimap<string, pair<int, int>>& Map)
{
    bool Found = false;

    cout << "\n=====================================\n";
    cout << "          Passed Students\n";
    cout << "=====================================\n";

    for (auto Val : Map)
    {
        int Mark = Val.second.second;

        // Passing starts from 550
        if (Mark >= 550)
        {
            cout << Val.first
                 << " | ID: "
                 << Val.second.first
                 << " | Mark: "
                 << Mark
                 << " | Grade: "
                 << GetGradeName(Mark)
                 << "\n";

            Found = true;
        }
    }

    if (!Found)
        cout << "No Passed Students Found.\n";
}

