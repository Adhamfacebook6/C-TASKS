{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }

    int MaxGrade = -1;

    // Find highest grade
    for (auto Val : Map)
    {
        int Mark = Val.second.second;

        if (Mark > MaxGrade)
            MaxGrade = Mark;
    }

    cout << "\n=====================================\n";
    cout << "       Students With Highest Grade\n";
    cout << "=====================================\n";

    cout << "Highest Grade: "
         << MaxGrade
         << "\n\n";

    // Display all students with highest grade
    for (auto Val : Map)
    {
        int Mark = Val.second.second;

        if (Mark == MaxGrade)
        {
            cout << "Name: "
                 << Val.first
                 << " | ID: "
                 << Val.second.first
                 << " | Mark: "
                 << Mark
                 << " | Grade: "
                 << GetGradeName(Mark)
                 << " | Letter: "
                 << GetLetterGrade(Mark)
                 << "\n";
        }
    }
}

// ==========================================
// Search By ID Menu
// ==========================================
void SearchStudentById(
    const multimap<string, pair<int, int>>& Map)
{
    int SearchId;

    cout << "\nEnter Student ID: ";
    cin >> SearchId;

    if (!SearchById(Map, SearchId))
    {
        cout << "\nStudent With ID "
             << SearchId
             << " Not Found.\n";
    }
}

// ==========================================
// Main
// ==========================================
int main()
{
    multimap<string, pair<int, int>> Map;

    cout << "Enter Number Of Students: ";

    int Num;
    cin >> Num;

    if (Num <= 0)
    {
        cout << "Invalid Value!\n";
        return 0;
    }

    // ==========================================
    // Initial Student Input
    // ==========================================
    cout << "\nEnter Name & ID & Mark\n";

    for (int i = 0; i < Num; ++i)
    {
        string Name;
        int Id;
        int Mark;

        cout << "\nStudent "
             << i + 1
             << "\n";

        cout << "Name: ";
        cin >> Name;

        cout << "ID: ";
        cin >> Id;

        // Prevent Duplicate ID
        if (IsIdExists(Map, Id))
        {
            cout << "This ID Already Exists!\n";
            cout << "Please Enter Another ID: ";

            while (IsIdExists(Map, Id))
            {
                cin >> Id;

                if (IsIdExists(Map, Id))
                {
                    cout << "This ID Already Exists!\n";
                    cout << "Please Enter Another ID: ";
                }
            }
        }
        cout << "Mark (0 - 1000): ";
        Mark = GetValidMark();
        Map.insert({
            Name,
            {Id, Mark}
        });
    }
    // ==========================================
    // Main Menu
    // ==========================================
    while (true)
    {
        cout << "\n\n";
        cout << "=====================================\n";
        cout << "      Student Management System\n";
        cout << "=====================================\n";
        cout << "1. Display All Students\n";
        cout << "2. Add New Student\n";
        cout << "3. Search By Name\n";
        cout << "4. Search By ID\n";
        cout << "5. Update Student\n";
        cout << "6. Delete Student\n";
        cout << "7. Show Statistics\n";
        cout << "8. Highest / Lowest Per Grade\n";
        cout << "9. Show Passed Students\n";
        cout << "10. Show Failed Students\n";
        cout << "11. Show Students Above Grade\n";
        cout << "12. Show Students With Highest Grade\n";
        cout << "0. Exit\n";
        cout << "=====================================\n";
        cout << "Enter Your Choice: ";
        int Choice;
        cin >> Choice;
        switch (Choice)
        {
            // ==================================
            // Display All
            // ==================================
            case 1:
                DisplayAllStudents(Map);
                break;
            // ==================================
            // Add
            // ==================================
            case 2:
                AddStudent(Map);
                break;
            // ==================================
            // Search By Name
            // ==================================
            case 3:
                SearchByName(Map);
                break;
            // ==================================
            // Search By ID
            // ==================================
            case 4:
                SearchStudentById(Map);
                break;
            // ==================================
            // Update
            // ==================================
            case 5:
                UpdateStudent(Map);
                break;
            // ==================================
            // Delete
            // ==================================
            case 6:
                DeleteStudent(Map);
                break;
            // ==================================
            // Statistics
            // ==================================
            case 7:
                ShowStatistics(Map);
                break;
            // ==================================
            // Highest / Lowest
            // ==================================
            case 8:
                HighestLowestEachGrade(Map);
                break;
