void HighestLowestEachGrade(const StudentMap& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }

    struct GradeStats
    {
        int Max = -1;
        int Min = MAXMARK + 1;
        int Count = 0;
        int Sum = 0;
    };

    GradeStats Excellent, VeryGood, Good, Pass, Fail;

    for (const auto& Pair : Map)
    {
        const int Mark = Pair.second.Mark;
        GradeStats* Current = nullptr;

        if (Mark >= EXCELLENTMIN)
            Current = &Excellent;
        else if (Mark >= VERYGOODMIN)
            Current = &VeryGood;
        else if (Mark >= GOODMIN)
            Current = &Good;
        else if (Mark >= PASSMIN)
            Current = &Pass;
        else
            Current = &Fail;

        Current->Max = max(Current->Max, Mark);
        Current->Min = min(Current->Min, Mark);
        ++Current->Count;
        Current->Sum += Mark;
    }
    cout << "\n=====================================\n"
         << "      Grade Detailed Statistics\n"
         << "=====================================\n";

    const auto DisplayGrade =
        [](const string& Name, const GradeStats& S)
    {
        cout << '\n' << Name << ":\n";

        if (S.Count == 0)
        {
            cout << "No Students\n";
            return;
        }
        cout << "Students: " << S.Count << '\n'
             << "Highest: " << S.Max << '\n'
             << "Lowest: " << S.Min << '\n'
             << fixed << setprecision(2)
             << "Average: "
             << static_cast<double>(S.Sum) / S.Count << '\n';
    };
    DisplayGrade("Excellent", Excellent);
    DisplayGrade("Very Good", VeryGood);
    DisplayGrade("Good", Good);
    DisplayGrade("Pass", Pass);
    DisplayGrade("Fail", Fail);
}
void ShowAdvancedStatistics(const StudentMap& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }
    const int TotalStudents = GetStudentCount(Map);
    int Sum = 0;
    int Passed = 0;
    int Failed = 0;
    int PassedSum = 0;
    int FailedSum = 0;
    int MaxGrade = -1;
    int MinGrade = MAXMARK + 1;

    int ACount = 0, BCount = 0, CCount = 0;
    int DCount = 0, FCount = 0;

    for (const auto& Pair : Map)
    {
        const int Mark = Pair.second.Mark;

        Sum += Mark;
        MaxGrade = max(MaxGrade, Mark);
        MinGrade = min(MinGrade, Mark);

        if (IsPassed(Mark))
        {
            ++Passed;
            PassedSum += Mark;
        }
        else
        {
            ++Failed;
            FailedSum += Mark;
        }
        switch (GetLetterGrade(Mark))
        {
            case 'A': ++ACount; break;
            case 'B': ++BCount; break;
            case 'C': ++CCount; break;
            case 'D': ++DCount; break;
            case 'F': ++FCount; break;
        }
    }
    const double Average =
        static_cast<double>(Sum) / TotalStudents;
    int AboveAverage = 0;
    int BelowAverage = 0;
    int EqualAverage = 0;
    for (const auto& Pair : Map)
    {
        const int Mark = Pair.second.Mark;

        if (Mark > Average)
            ++AboveAverage;
        else if (Mark < Average)
            ++BelowAverage;
        else
            ++EqualAverage;
    }
    const double PassRate =
        static_cast<double>(Passed) / TotalStudents * 100.0;
    const double FailRate =
        static_cast<double>(Failed) / TotalStudents * 100.0;
    cout << "\n============================================\n"
         << "          ADVANCED STATISTICS\n"
         << "============================================\n"
         << "Total Students: " << TotalStudents << '\n'
         << "Total Grades: " << Sum << '\n'
         << fixed << setprecision(2)
         << "Average: " << Average << '\n'
         << "Median: " << CalculateMedian(Map) << '\n'
         << "Highest Grade: " << MaxGrade << '\n'
         << "Lowest Grade: " << MinGrade << '\n'
         << "Difference: " << MaxGrade - MinGrade << '\n'
         << "\nPassed Students: " << Passed << '\n'
         << "Failed Students: " << Failed << '\n'
         << "Pass Rate: " << PassRate << "%\n"
         << "Fail Rate: " << FailRate << "%\n"
         << "\nStudents Above Average: " << AboveAverage << '\n'
         << "Students Below Average: " << BelowAverage << '\n'
         << "Students Equal To Average: " << EqualAverage << '\n'
         << "\nSum Of Passed Grades: " << PassedSum << '\n'
         << "Sum Of Failed Grades: " << FailedSum << '\n'
         << "\nLetter Grade Statistics:\n"
         << "A: " << ACount << '\n'
         << "B: " << BCount << '\n'
         << "C: " << CCount << '\n'
         << "D: " << DCount << '\n'
         << "F: " << FCount << '\n';
}
