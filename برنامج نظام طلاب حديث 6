void StatisticsMenu(const StudentMap& Map)
{
    while (true)
    {
        cout << "\n=====================================\n"
             << "          Statistics Menu\n"
             << "=====================================\n"
             << "1. Advanced Statistics\n"
             << "2. Highest / Lowest Per Grade\n"
             << "3. Top N Students\n"
             << "4. Lowest N Students\n"
             << "5. Highest Grade Students\n"
             << "6. Passed Students\n"
             << "7. Failed Students\n"
             << "0. Back\n";
        const int Choice = GetValidInteger("Enter Choice: ");
        switch (Choice)
        {
            case 1: ShowAdvancedStatistics(Map); break;
            case 2: HighestLowestEachGrade(Map); break;
            case 3: DisplayTopN(Map); break;
            case 4: DisplayBottomN(Map); break;
            case 5: DisplayHighestStudents(Map); break;
            case 6: DisplayPassedStudents(Map); break;
            case 7: DisplayFailedStudents(Map); break;
            case 0: return;
            default: cout << "Invalid Choice!\n";
        }
    }
}
// ============================================================
// Main
// ============================================================
int main()
{
    try
    {
        StudentMap Map;

        cout << "=====================================\n"
             << "      Student Management System\n"
             << "=====================================\n"
             << "\nDo You Want To Load Saved Data?\n"
             << "1. Yes\n"
             << "0. No\n";

        const int LoadChoice = GetValidInteger("Enter Choice: ");

        if (LoadChoice == 1)
            LoadFromFile(Map);
        else if (LoadChoice != 0)
            cout << "Invalid Choice. Starting Without Loading.\n";

        if (Map.empty())
        {
            const int Num =
                GetValidPositiveNumber("\nEnter Number Of Students: ");

            for (int i = 0; i < Num; ++i)
            {
                cout << "\n=====================================\n"
                     << "Student " << i + 1 << '\n'
                     << "=====================================\n";

                Student S;

                S.Name = GetStudentName("Name: ");
                S.Id = GetValidId();

                while (IsIdExists(Map, S.Id))
                {
                    cout << "This ID Already Exists!\n";
                    S.Id = GetValidId();
                }

                S.Mark = GetValidMark();

                Map.emplace(S.Name, S);
            }
        }
        while (true)
        {
            cout << "\n\n============================================\n"
                 << "        Student Management System\n"
                 << "============================================\n"
                 << "1.  Display All Students\n"
                 << "2.  Add New Student\n"
                 << "3.  Search By Name\n"
                 << "4.  Search By ID\n"
                 << "5.  Search By Mark Range\n"
                 << "6.  Update Student\n"
                 << "7.  Delete Student By ID\n"
                 << "8.  Delete All Students By Name\n"
                 << "9.  Sort Students By Mark\n"
                 << "10. Students Above Specific Grade\n"
                 << "11. Statistics Menu\n"
                 << "12. Save Data\n"
                 << "13. Load Data\n"
                 << "14. Export Report\n"
                 << "0.  Exit\n"
                 << "============================================\n";

            const int Choice =
                GetValidInteger("Enter Your Choice: ");

            switch (Choice)
            {
                case 1: DisplayAllStudents(Map); break;
                case 2: AddStudent(Map); break;
                case 3: SearchByName(Map); break;
                case 4: SearchStudentById(Map); break;
                case 5: SearchByMarkRange(Map); break;
                case 6: UpdateStudent(Map); break;
                case 7: DeleteStudent(Map); break;
                case 8: DeleteByName(Map); break;
                case 9: SortStudentsByMark(Map); break;
                case 10: DisplayStudentsAboveGrade(Map); break;
                case 11: StatisticsMenu(Map); break;
                case 12: SaveToFile(Map); break;
                case 13: LoadFromFile(Map); break;
                case 14: ExportReport(Map); break;
                case 0:
                    cout << "\nSaving Data Before Exit...\n";
                    SaveToFile(Map);
                    cout << "\nProgram Ended.\n";
                    return 0;

                default:
                    cout << "\nInvalid Choice!\n";
            }
        }
    }
    catch (const exception& Error)
    {
        cerr << "\nError: " << Error.what() << '\n';
        return 1;
    }
}
