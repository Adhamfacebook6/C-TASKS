void SaveToFile(const StudentMap& Map)
{
    ofstream File("students.txt");

    if (!File)
    {
        cout << "\nError Opening File!\n";
        return;
    }

    for (const auto& Pair : Map)
    {
        const Student& S = Pair.second;

        File << S.Name << '|'
             << S.Id << '|'
             << S.Mark << '\n';
    }

    File.close();

    if (!File)
    {
        cout << "\nError Writing To File!\n";
        return;
    }

    cout << "\nData Saved Successfully To students.txt\n";
}

void LoadFromFile(StudentMap& Map)
{
    ifstream File("students.txt");

    if (!File)
    {
        cout << "\nNo Save File Found.\n";
        return;
    }

    StudentMap LoadedStudents;
    string Name, IdText, MarkText;

    while (getline(File, Name, '|') &&
           getline(File, IdText, '|') &&
           getline(File, MarkText))
    {
        try
        {
            size_t IdPosition = 0;
            size_t MarkPosition = 0;

            const int Id = stoi(IdText, &IdPosition);
            const int Mark = stoi(MarkText, &MarkPosition);

            if (IdPosition != IdText.size() ||
                MarkPosition != MarkText.size() ||
                Name.empty() ||
                Id <= 0 ||
                Mark < 0 ||
                Mark > MAXMARK ||
                IsIdExists(LoadedStudents, Id))
            {
                continue;
            }

            LoadedStudents.emplace(
                Name, Student{Name, Id, Mark});
        }
        catch (const exception&)
        {
            // Ignore malformed records.
        }
    }
    if (File.bad())
    {
        cout << "\nError Reading Save File. Existing Data Preserved.\n";
        return;
    }
    Map.swap(LoadedStudents);
    cout << "\nData Loaded Successfully.\n"
         << "Students Loaded: " << Map.size() << '\n';
}
