// Grade System
// ============================================================
constexpr int EXCELLENTMIN = 900;
constexpr int VERYGOODMIN = 850;
constexpr int GOODMIN = 700;
constexpr int PASSMIN = 550;
constexpr int MAXMARK = 1000;
// ============================================================
// Student Data
// ============================================================
struct Student
{
    string Name;
    int Id{};
    int Mark{};
};

using StudentMap = multimap<string, Student>;

// ============================================================
// Input Validation
// ============================================================
int GetValidInteger(const string& Message)
{
    int Value{};

    while (true)
    {
        cout << Message;

        if (cin >> Value)
            return Value;
        if (cin.eof())
            throw runtime_error("Input stream closed.");
        cout << "Invalid Input! Please Enter A Number.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }
}
string GetStudentName(const string& Message)
{
    string Name;
    while (true)
    {
        cout << Message;
        if (!getline(cin >> ws, Name))
            throw runtime_error("Input stream closed.");

        if (Name.empty())
        {
            cout << "Name Cannot Be Empty.\n";
            continue;
        }
        if (Name.find('|') != string::npos)
        {
            cout << "Name Cannot Contain The | Character.\n";
            continue;
        }
        return Name;
    }
}
int GetValidMark()
{
    while (true)
    {
        const int Mark = GetValidInteger("Enter Mark (0 - 1000): ");

        if (Mark >= 0 && Mark <= MAXMARK)
            return Mark;

        cout << "Invalid Mark!\n"
             << "Mark Must Be Between 0 And 1000.\n";
    }
}

int GetValidId()
{
    while (true)
    {
        const int Id = GetValidInteger("Enter Student ID: ");

        if (Id > 0)
            return Id;

        cout << "ID Must Be Greater Than 0.\n";
    }
}

int GetValidPositiveNumber(const string& Message)
{
    while (true)
    {
        const int Number = GetValidInteger(Message);

        if (Number > 0)
            return Number;

        cout << "Please Enter A Number Greater Than 0.\n";
    }
 // ============================================================
// Grade Calculations
// ============================================================
string GetGradeName(int Mark)
{
    if (Mark >= EXCELLENTMIN)
        return "Excellent";
    if (Mark >= VERYGOODMIN)
        return "Very Good";
    if (Mark >= GOODMIN)
        return "Good";
    if (Mark >= PASSMIN)
        return "Pass";
    return "Fail";
}
char GetLetterGrade(int Mark)
{
    if (Mark >= EXCELLENTMIN)
        return 'A';
    if (Mark >= VERYGOODMIN)
        return 'B';
    if (Mark >= GOODMIN)
        return 'C';
    if (Mark >= PASSMIN)
        return 'D';
    return 'F';
}
bool IsPassed(int Mark)
{
    return Mark >= PASSMIN;
}
double GetPercentage(int Mark)
{
    return static_cast<double>(Mark) / MAXMARK * 100.0;
}

// ============================================================
// Student Utilities
// ============================================================
bool IsIdExists(const StudentMap& Map, int SearchId)
{
    for (const auto& Pair : Map)
    {
        if (Pair.second.Id == SearchId)
            return true;
    }

    return false;
}
int GetStudentCount(const StudentMap& Map)
{
    return static_cast<int>(Map.size());
}

vector<Student> GetStudentsVector(const StudentMap& Map)
{
    vector<Student> Students;
    Students.reserve(Map.size());
    for (const auto& Pair : Map)
        Students.push_back(Pair.second);
    return Students;
}
// ============================================================
// Display Students
// ============================================================
void DisplayStudent(const Student& S)
{
    cout << "Name: " << S.Name << '\n'
         << "ID: " << S.Id << '\n'
         << "Mark: " << S.Mark << '\n'
         << fixed << setprecision(2)
         << "Percentage: " << GetPercentage(S.Mark) << "%\n"
         << "Grade: " << GetGradeName(S.Mark) << '\n'
         << "Letter Grade: " << GetLetterGrade(S.Mark) << '\n'
         << "Status: "
         << (IsPassed(S.Mark) ? "Passed" : "Failed") << '\n';
}

void DisplayAllStudents(const StudentMap& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }
    cout << "\n============================================\n"
         << "              All Students\n"
         << "============================================\n";
    for (const auto& Pair : Map)
    {
        const Student& S = Pair.second;
        cout << S.Name
             << " | ID: " << S.Id
             << " | Mark: " << S.Mark
             << " | Grade: " << GetGradeName(S.Mark)
             << " (" << GetLetterGrade(S.Mark) << ") | "
             << fixed << setprecision(2)
             << GetPercentage(S.Mark)
             << "% | "
             << (IsPassed(S.Mark) ? "Passed" : "Failed")
             << '\n';
    }
}
// ============================================================
// Add Student
// ============================================================
void AddStudent(StudentMap& Map)
{
    Student S;
    S.Name = GetStudentName("\nEnter Student Name: ");
    S.Id = GetValidId();
    while (IsIdExists(Map, S.Id))
    {
        cout << "This ID Already Exists!\n";
        S.Id = GetValidId();
    }
    S.Mark = GetValidMark();

    Map.emplace(S.Name, S);
    cout << "\nStudent Added Successfully!\n";
}
