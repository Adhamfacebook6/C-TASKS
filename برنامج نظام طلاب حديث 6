// Sorting and Statistics
// ============================================================
void SortStudentsByMark(const StudentMap& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }

    vector<Student> Students = GetStudentsVector(Map);

    cout << "\n=====================================\n"
         << "1. Highest To Lowest\n"
         << "2. Lowest To Highest\n"
         << "=====================================\n";

    const int Choice = GetValidInteger("Enter Choice: ");

    if (Choice == 1)
    {
        stable_sort(Students.begin(), Students.end(),
            [](const Student& A, const Student& B)
            {
                return A.Mark > B.Mark;
            });
    }
    else if (Choice == 2)
    {
        stable_sort(Students.begin(), Students.end(),
            [](const Student& A, const Student& B)
            {
                return A.Mark < B.Mark;
            });
    }
    else
    {
        cout << "Invalid Choice.\n";
        return;
    }

    cout << "\n=====================================\n"
         << "        Students Sorted By Mark\n"
         << "=====================================\n";

    for (const Student& S : Students)
    {
        cout << S.Name
             << " | ID: " << S.Id
             << " | Mark: " << S.Mark
             << " | Grade: " << GetGradeName(S.Mark) << '\n';
    }
}

double CalculateMedian(const StudentMap& Map)
{
    vector<Student> Students = GetStudentsVector(Map);

    if (Students.empty())
        return 0.0;

    sort(Students.begin(), Students.end(),
        [](const Student& A, const Student& B)
        {
            return A.Mark < B.Mark;
        });

    const size_t Size = Students.size();

    if (Size % 2 == 1)
        return Students[Size / 2].Mark;

    return (
        static_cast<double>(Students[Size / 2 - 1].Mark) +
        Students[Size / 2].Mark
    ) / 2.0;
}

