        static_cast<double>(Sum) / Map.size();
    File << "============================================\n"
         << "          STUDENT MANAGEMENT REPORT\n"
         << "============================================\n\n"
         << "Total Students: " << Map.size() << '\n'
         << "Total Grades: " << Sum << '\n'
         << fixed << setprecision(2)
         << "Average: " << Average << '\n'
         << "Median: " << CalculateMedian(Map) << '\n'
         << "Highest Grade: " << MaxGrade << '\n'
         << "Lowest Grade: " << MinGrade << '\n'
         << "Difference: " << MaxGrade - MinGrade << '\n'
         << "Passed Students: " << Passed << '\n'
         << "Failed Students: " << Failed << "\n\n"
         << "============================================\n"
         << "                STUDENTS\n"
         << "============================================\n\n";
    for (const auto& Pair : Map)
    {
        const Student& S = Pair.second;
        File << "Name: " << S.Name << '\n'
             << "ID: " << S.Id << '\n'
             << "Mark: " << S.Mark << '\n'
             << "Percentage: " << GetPercentage(S.Mark) << "%\n"
             << "Grade: " << GetGradeName(S.Mark) << '\n'
             << "Letter Grade: " << GetLetterGrade(S.Mark) << '\n'
             << "Status: "
             << (IsPassed(S.Mark) ? "Passed" : "Failed") << '\n'
             << "--------------------------------------------\n";
    }
    File.close();
    if (!File)
    {
        cout << "\nError Writing Report File!\n";
        return;
    }

    cout << "\nReport Exported Successfully To studentreport.txt\n";
}
