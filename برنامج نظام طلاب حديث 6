bool SearchById(const StudentMap& Map, int SearchId)
{
    for (const auto& Pair : Map)
    {
        const Student& S = Pair.second;

        if (S.Id == SearchId)
        {
            cout << "\n=====================================\n"
                 << "             Student Found\n"
                 << "=====================================\n";

            DisplayStudent(S);
            return true;
        }
    }
    return false;
}
void SearchStudentById(const StudentMap& Map)
{
    const int SearchId = GetValidId();

    if (!SearchById(Map, SearchId))
        cout << "\nStudent With ID " << SearchId
             << " Not Found.\n";
}
void SearchByName(const StudentMap& Map)
{
    const string SearchName =
        GetStudentName("\nEnter Student Name: ");
    const auto Range = Map.equal_range(SearchName);

    if (Range.first == Range.second)
    {
        cout << "Student Not Found.\n";
        return;
    }
    cout << "\n=====================================\n"
         << "Students With Name: " << SearchName << '\n'
         << "=====================================\n";

    for (auto It = Range.first; It != Range.second; ++It)
    {
        DisplayStudent(It->second);
        cout << "-------------------------------------\n";
    }
}
void SearchByMarkRange(const StudentMap& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }
    cout << "\nEnter Minimum Mark.\n";
    int Minimum = GetValidMark();
    cout << "Enter Maximum Mark.\n";
    int Maximum = GetValidMark();
    if (Minimum > Maximum)
        swap(Minimum, Maximum);
    bool Found = false;
    cout << "\n=====================================\n"
         << "Students Between " << Minimum
         << " And " << Maximum << '\n'
         << "=====================================\n";

    for (const auto& Pair : Map)
    {
        const Student& S = Pair.second;

        if (S.Mark >= Minimum && S.Mark <= Maximum)
        {
            cout << S.Name
                 << " | ID: " << S.Id
                 << " | Mark: " << S.Mark
                 << " | Grade: " << GetGradeName(S.Mark)
                 << '\n';

            Found = true;
        }
    }
    if (!Found)
        cout << "No Students Found In This Range.\n";
}
 // ============================================================
// Update and Delete Students
// ============================================================
void UpdateStudent(StudentMap& Map)
{
    const int SearchId = GetValidId();

    for (auto It = Map.begin(); It != Map.end(); ++It)
    {
        if (It->second.Id != SearchId)
            continue;

        const Student OldStudent = It->second;

        cout << "\nCurrent Student Data:\n";
        DisplayStudent(OldStudent);

        cout << "\n========== Update Menu ==========\n"
             << "1. Change Name\n"
             << "2. Change ID\n"
             << "3. Change Mark\n"
             << "4. Change All\n"
             << "0. Cancel\n";

        const int Choice = GetValidInteger("Enter Choice: ");
        Student NewStudent = OldStudent;

        switch (Choice)
        {
            case 1:
                NewStudent.Name = GetStudentName("Enter New Name: ");
                break;

            case 2:
                NewStudent.Id = GetValidId();

                while (NewStudent.Id != OldStudent.Id &&
                       IsIdExists(Map, NewStudent.Id))
                {
                    cout << "This ID Already Exists!\n";
                    NewStudent.Id = GetValidId();
                }
                break;

            case 3:
                NewStudent.Mark = GetValidMark();
                break;

            case 4:
                NewStudent.Name = GetStudentName("Enter New Name: ");
                NewStudent.Id = GetValidId();

                while (NewStudent.Id != OldStudent.Id &&
                       IsIdExists(Map, NewStudent.Id))
                {
                    cout << "This ID Already Exists!\n";
                    NewStudent.Id = GetValidId();
                }

                NewStudent.Mark = GetValidMark();
                break;

            case 0:
                cout << "Update Cancelled.\n";
                return;

            default:
                cout << "Invalid Choice.\n";
                return;
        }

        // Insert the new record before deleting the old record.
        Map.emplace(NewStudent.Name, NewStudent);
        Map.erase(It);

        cout << "\nStudent Updated Successfully!\n";
        return;
    }

    cout << "\nStudent Not Found!\n";
}
void DeleteStudent(StudentMap& Map)
{
    const int DeleteId = GetValidId();
    for (auto It = Map.begin(); It != Map.end(); ++It)
    {
        if (It->second.Id == DeleteId)
        {
            cout << "\nStudent Found:\n";
            DisplayStudent(It->second);

            Map.erase(It);

            cout << "\nStudent Deleted Successfully!\n";
            return;
        }
    }
    cout << "\nStudent Not Found!\n";
}
void DeleteByName(StudentMap& Map)
{
    const string Name =
        GetStudentName("\nEnter Student Name: ");
    const auto Range = Map.equal_range(Name);
    if (Range.first == Range.second)
    {
        cout << "No Students Found With This Name.\n";
        return;
    }

    int Count = 0;

    for (auto It = Range.first; It != Range.second; ++It)
    {
        cout << "ID: " << It->second.Id
             << " | Mark: " << It->second.Mark << '\n';
        ++Count;
    }
    cout << "\nFound " << Count << " Student(s).\n";
    const int Choice =
        GetValidInteger("Delete All? (1 = Yes, 0 = No): ");
    if (Choice == 1)
    {
        Map.erase(Name);
        cout << "\nAll Students With Name "
             << Name << " Deleted.\n";
    }
    else
    {
        cout << "Operation Cancelled.\n";
    }
}
