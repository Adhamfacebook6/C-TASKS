void DeleteStudent(StudentMap& Map)
{
    int DeleteId =
        GetValidId();

    for (auto It = Map.begin();
         It != Map.end();
         ++It)
    {
        if (It->second.first == DeleteId)
        {
            cout << "\nStudent Found:\n";

            DisplayStudent(
                It->first,
                It->second.first,
                It->second.second
            );

            Map.erase(It);

            cout << "\nStudent Deleted Successfully!\n";
            return;
        }
    }

    cout << "\nStudent Not Found!\n";
}

