// ============================================================
// Save Data To File
// ============================================================

void SaveToFile(const StudentMap& Map)
{
    ofstream File("students.txt");

    if (!File)
    {
        cout << "\nError Opening File!\n";
        return;
    }

    for (auto Val : Map)
    {
        File << Val.first
             << " "
             << Val.second.first
             << " "
             << Val.second.second
             << "\n";
    }

    File.close();

    cout << "\nData Saved Successfully To students.txt\n";
}

// ============================================================
// Load Data From File
// ============================================================

void LoadFromFile(StudentMap& Map)
{
    ifstream File("students.txt");

    if (!File)
    {
        cout << "\nNo Save File Found.\n";
        return;
    }

    Map.clear();

    string Name;
    int Id;
    int Mark;

    while (File >> Name >> Id >> Mark)
    {
        if (Id > 0 &&
            Mark >= 0 &&
            Mark <= MAX_MARK &&
            !IsIdExists(Map, Id))
        {
            Map.insert({
                Name,
                {Id, Mark}
            });
        }
    }

    File.close();

    cout << "\nData Loaded Successfully.\n";
}

// ============================================================
// Export Report
// ============================================================

void ExportReport(const StudentMap& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students To Export.\n";
        return;
    }

    ofstream File("student_report.txt");

    if (!File)
    {
        cout << "\nError Creating Report File!\n";
        return;
    }

    int Sum = 0;
    int Passed = 0;
    int Failed = 0;

    int MaxGrade = -1;
    int MinGrade = 1001;

    for (auto Val : Map)
    {
        int Mark = Val.second.second;

        Sum += Mark;

        MaxGrade =
            max(MaxGrade, Mark);

        MinGrade =
            min(MinGrade, Mark);

        if (IsPassed(Mark))
            Passed++;
        else
            Failed++;
    }

    double Average =
        static_cast<double>(Sum) / Map.size();

    File << "============================================\n";
    File << "          STUDENT MANAGEMENT REPORT\n";
    File << "============================================\n\n";

    File << "Total Students: "
         << Map.size()
         << "\n";

    File << "Total Grades: "
         << Sum
         << "\n";

    File << fixed << setprecision(2);

    File << "Average: "
         << Average
         << "\n";

    File << "Median: "
         << CalculateMedian(Map)
         << "\n";

    File << "Highest Grade: "
         << MaxGrade
         << "\n";

    File << "Lowest Grade: "
         << MinGrade
         << "\n";

    File << "Difference: "
         << MaxGrade - MinGrade
         << "\n";

    File << "Passed Students: "
         << Passed
         << "\n";

    File << "Failed Students: "
         << Failed
         << "\n\n";

    File << "============================================\n";
    File << "                STUDENTS\n";
    File << "============================================\n\n";

    for (auto Val : Map)
    {
        File << "Name: "
             << Val.first
             << "\n";

        File << "ID: "
             << Val.second.first
             << "\n";

        File << "Mark: "
             << Val.second.second
             << "\n";

        File << "Percentage: "
             << GetPercentage(Val.second.second)
             << "%\n";

        File << "Grade: "
             << GetGradeName(Val.second.second)
             << "\n";

        File << "Letter Grade: "
             << GetLetterGrade(Val.second.second)
             << "\n";

        File << "Status: "
             << (IsPassed(Val.second.second)
                     ? "Passed"
                     : "Failed")
             << "\n";

        File << "--------------------------------------------\n";
    }

    File.close();

    cout << "\nReport Exported Successfully To "
         << "student_report.txt\n";
}

