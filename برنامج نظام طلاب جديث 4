// ============================================================
// Search By Mark Range
// ============================================================

void SearchByMarkRange(const StudentMap& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }

    cout << "\nEnter Minimum Mark.\n";
    int Minimum = GetValidMark();

    cout << "Enter Maximum Mark.\n";
    int Maximum = GetValidMark();

    if (Minimum > Maximum)
    {
        swap(Minimum, Maximum);
    }

    bool Found = false;

    cout << "\n=====================================\n";
    cout << "Students Between "
         << Minimum
         << " And "
         << Maximum
         << "\n";
    cout << "=====================================\n";

    for (auto Val : Map)
    {
        int Mark = Val.second.second;

        if (Mark >= Minimum && Mark <= Maximum)
        {
            cout << Val.first
                 << " | ID: "
                 << Val.second.first
                 << " | Mark: "
                 << Mark
                 << " | Grade: "
                 << GetGradeName(Mark)
                 << "\n";

            Found = true;
        }
    }

    if (!Found)
        cout << "No Students Found In This Range.\n";
}

// ============================================================
// Update Student
// ============================================================

void UpdateStudent(StudentMap& Map)
{
    int SearchId =
        GetValidId();

    for (auto It = Map.begin();
         It != Map.end();
         ++It)
    {
        if (It->second.first == SearchId)
        {
            string OldName = It->first;
            int OldId = It->second.first;
            int OldMark = It->second.second;

            cout << "\nCurrent Student Data:\n";
            DisplayStudent(
                OldName,
                OldId,
                OldMark
            );

            cout << "\n========== Update Menu ==========\n";
            cout << "1. Change Name\n";
            cout << "2. Change ID\n";
            cout << "3. Change Mark\n";
            cout << "4. Change All\n";
            cout << "0. Cancel\n";

            int Choice =
                GetValidInteger("Enter Choice: ");

            string NewName = OldName;
            int NewId = OldId;
            int NewMark = OldMark;

            switch (Choice)
            {
                case 1:
                    NewName =
                        GetStudentName("Enter New Name: ");
                    break;

                case 2:
                    NewId = GetValidId();

                    while (NewId != OldId &&
                           IsIdExists(Map, NewId))
                    {
                        cout << "This ID Already Exists!\n";
                        NewId = GetValidId();
                    }

                    break;

                case 3:
                    NewMark = GetValidMark();
                    break;

                case 4:
                    NewName =
                        GetStudentName("Enter New Name: ");

                    NewId = GetValidId();

                    while (NewId != OldId &&
                           IsIdExists(Map, NewId))
                    {
                        cout << "This ID Already Exists!\n";
                        NewId = GetValidId();
                    }

                    NewMark = GetValidMark();
                    break;

                case 0:
                    cout << "Update Cancelled.\n";
                    return;

                default:
                    cout << "Invalid Choice.\n";
                    return;
            }

            Map.erase(It);

            Map.insert({
                NewName,
                {NewId, NewMark}
            });

            cout << "\nStudent Updated Successfully!\n";
            return;
        }
    }

    cout << "\nStudent Not Found!\n";
}

