// ============================================================
// Search By Mark Range
// ============================================================

void SearchByMarkRange(
    const StudentMap& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }

    cout << "\nEnter Minimum Mark.\n";

    int Minimum = GetValidMark();

    cout << "Enter Maximum Mark.\n";

    int Maximum = GetValidMark();

    if (Minimum > Maximum)
        swap(Minimum, Maximum);

    bool Found = false;

    cout << "\n=====================================\n";
    cout << "Students Between "
         << Minimum
         << " And "
         << Maximum
         << "\n";
    cout << "=====================================\n";

    for (const auto& Pair : Map)
    {
        const Student& S = Pair.second;

        if (S.Mark >= Minimum &&
            S.Mark <= Maximum)
        {
            cout << S.Name
                 << " | ID: "
                 << S.Id
                 << " | Mark: "
                 << S.Mark
                 << " | Grade: "
                 << GetGradeName(S.Mark)
                 << "\n";

            Found = true;
        }
    }

    if (!Found)
        cout << "No Students Found In This Range.\n";
}

// ============================================================
// Update Student
// ============================================================

void UpdateStudent(
    StudentMap& Map)
{
    int SearchId = GetValidId();

    for (auto It = Map.begin();
         It != Map.end();
         ++It)
    {
        if (It->second.Id == SearchId)
        {
            Student OldStudent =
                It->second;

            cout << "\nCurrent Student Data:\n";

            DisplayStudent(OldStudent);

            cout << "\n========== Update Menu ==========\n";
            cout << "1. Change Name\n";
            cout << "2. Change ID\n";
            cout << "3. Change Mark\n";
            cout << "4. Change All\n";
            cout << "0. Cancel\n";

            int Choice =
                GetValidInteger(
                    "Enter Choice: "
                );

            Student NewStudent =
                OldStudent;

            switch (Choice)
            {
                case 1:
                {
                    NewStudent.Name =
                        GetStudentName(
                            "Enter New Name: "
                        );

                    break;
                }

                case 2:
                {
                    NewStudent.Id =
                        GetValidId();

                    while (
                        NewStudent.Id != OldStudent.Id &&
                        IsIdExists(
                            Map,
                            NewStudent.Id
                        )
                    )
                    {
                        cout << "This ID Already Exists!\n";

                        NewStudent.Id =
                            GetValidId();
                    }

                    break;
                }

                case 3:
                {
                    NewStudent.Mark =
                        GetValidMark();

                    break;
                }

                case 4:
                {
                    NewStudent.Name =
                        GetStudentName(
                            "Enter New Name: "
                        );

                    NewStudent.Id =
                        GetValidId();

                    while (
                        NewStudent.Id != OldStudent.Id &&
                        IsIdExists(
                            Map,
                            NewStudent.Id
                        )
                    )
                    {
                        cout << "This ID Already Exists!\n";

                        NewStudent.Id =
                            GetValidId();
                    }

                    NewStudent.Mark =
                        GetValidMark();

                    break;
                }

                case 0:
                {
                    cout << "Update Cancelled.\n";
                    return;
                }

                default:
                {
                    cout << "Invalid Choice.\n";
                    return;
                }
            }

            Map.erase(It);

            Map.insert({
                NewStudent.Name,
                NewStudent
            });

            cout << "\nStudent Updated Successfully!\n";

            return;
        }
    }

    cout << "\nStudent Not Found!\n";
}

// ============================================================
// Delete Student By ID
// ============================================================

void DeleteStudent(
    StudentMap& Map)
{
    int DeleteId = GetValidId();

    for (auto It = Map.begin();
         It != Map.end();
         ++It)
    {
        if (It->second.Id == DeleteId)
        {
            cout << "\nStudent Found:\n";

            DisplayStudent(It->second);

            Map.erase(It);

            cout << "\nStudent Deleted Successfully!\n";

            return;
        }
    }

    cout << "\nStudent Not Found!\n";
}

