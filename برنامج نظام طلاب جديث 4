// ============================================================
// Add Student
// ============================================================

void AddStudent(StudentMap& Map)
{
    Student S;

    S.Name = GetStudentName(
        "\nEnter Student Name: "
    );

    S.Id = GetValidId();

    while (IsIdExists(Map, S.Id))
    {
        cout << "This ID Already Exists!\n";

        S.Id = GetValidId();
    }

    S.Mark = GetValidMark();

    Map.insert({
        S.Name,
        S
    });

    cout << "\nStudent Added Successfully!\n";
}

// ============================================================
// Search By ID
// ============================================================

bool SearchById(
    const StudentMap& Map,
    int SearchId)
{
    for (const auto& Pair : Map)
    {
        const Student& S = Pair.second;

        if (S.Id == SearchId)
        {
            cout << "\n=====================================\n";
            cout << "             Student Found\n";
            cout << "=====================================\n";

            DisplayStudent(S);

            return true;
        }
    }

    return false;
}

