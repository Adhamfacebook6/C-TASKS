// ============================================================
// Highest / Lowest Per Grade
// ============================================================

void HighestLowestEachGrade(
    const StudentMap& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }

    struct GradeStats
    {
        int Max = -1;
        int Min = 1001;
        int Count = 0;
        int Sum = 0;
    };

    GradeStats Excellent;
    GradeStats VeryGood;
    GradeStats Good;
    GradeStats Pass;
    GradeStats Fail;

    for (const auto& Pair : Map)
    {
        int Mark = Pair.second.Mark;

        GradeStats* Current = nullptr;

        if (Mark >= EXCELLENT_MIN)
            Current = &Excellent;

        else if (Mark >= VERY_GOOD_MIN)
            Current = &VeryGood;

        else if (Mark >= GOOD_MIN)
            Current = &Good;

        else if (Mark >= PASS_MIN)
            Current = &Pass;

        else
            Current = &Fail;

        Current->Max =
            max(Current->Max, Mark);

        Current->Min =
            min(Current->Min, Mark);

        Current->Count++;

        Current->Sum += Mark;
    }

    cout << "\n=====================================\n";
    cout << "      Grade Detailed Statistics\n";
    cout << "=====================================\n";

    auto DisplayGrade =
        [](const string& Name,
           const GradeStats& S)
        {
            cout << "\n"
                 << Name
                 << ":\n";

            if (S.Count == 0)
            {
                cout << "No Students\n";
                return;
            }

            cout << "Students: "
                 << S.Count
                 << "\n";

            cout << "Highest: "
                 << S.Max
                 << "\n";

            cout << "Lowest: "
                 << S.Min
                 << "\n";

            cout << fixed
                 << setprecision(2);

            cout << "Average: "
                 << static_cast<double>(S.Sum)
                    / S.Count
                 << "\n";
        };

    DisplayGrade(
        "Excellent",
        Excellent
    );

    DisplayGrade(
        "Very Good",
        VeryGood
    );

    DisplayGrade(
        "Good",
        Good
    );

    DisplayGrade(
        "Pass",
        Pass
    );

    DisplayGrade(
        "Fail",
        Fail
    );
}

// ============================================================
// Advanced Statistics
// ============================================================

void ShowAdvancedStatistics(
    const StudentMap& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }

    int TotalStudents =
        GetStudentCount(Map);

    int Sum = 0;

    int Passed = 0;
    int Failed = 0;

    int AboveAverage = 0;
    int BelowAverage = 0;
    int EqualAverage = 0;

    int PassedSum = 0;
    int FailedSum = 0;

    int MaxGrade = -1;
    int MinGrade = 1001;

    int ACount = 0;
    int BCount = 0;
    int CCount = 0;
    int DCount = 0;
    int FCount = 0;

    for (const auto& Pair : Map)
    {
        int Mark = Pair.second.Mark;

        Sum += Mark;

        MaxGrade =
            max(MaxGrade, Mark);

        MinGrade =
            min(MinGrade, Mark);

        if (IsPassed(Mark))
        {
            Passed++;

            PassedSum += Mark;
        }
        else
        {
            Failed++;

            FailedSum += Mark;
        }

        switch (GetLetterGrade(Mark))
        {
            case 'A':
                ACount++;
                break;

            case 'B':
                BCount++;
                break;

            case 'C':
                CCount++;
                break;

            case 'D':
                DCount++;
                break;

            case 'F':
                FCount++;
                break;
        }
    }

    double Average =
        static_cast<double>(Sum)
        / TotalStudents;

    for (const auto& Pair : Map)
    {
        int Mark = Pair.second.Mark;

        if (Mark > Average)
            AboveAverage++;

        else if (Mark < Average)
            BelowAverage++;

        else
            EqualAverage++;
    }

    double PassRate =
        static_cast<double>(Passed)
        / TotalStudents
        * 100;

    double FailRate =
        static_cast<double>(Failed)
        / TotalStudents
        * 100;

    double Median =
