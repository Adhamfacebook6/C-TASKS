// ============================================================
// Save Data To File
// ============================================================

void SaveToFile(
    const StudentMap& Map)
{
    ofstream File("students.txt");

    if (!File)
    {
        cout << "\nError Opening File!\n";
        return;
    }

    for (const auto& Pair : Map)
    {
        const Student& S = Pair.second;

        File << S.Name
             << "|"
             << S.Id
             << "|"
             << S.Mark
             << "\n";
    }

    File.close();

    cout << "\nData Saved Successfully To students.txt\n";
}

// ============================================================
// Load Data From File
// ============================================================

void LoadFromFile(
    StudentMap& Map)
{
    ifstream File("students.txt");

    if (!File)
    {
        cout << "\nNo Save File Found.\n";
        return;
    }

    Map.clear();

    string Name;
    string IdText;
    string MarkText;

    while (
        getline(File, Name, '|') &&
        getline(File, IdText, '|') &&
        getline(File, MarkText)
    )
    {
        try
        {
            int Id =
                stoi(IdText);

            int Mark =
                stoi(MarkText);

            if (
                !Name.empty() &&
                Id > 0 &&
                Mark >= 0 &&
                Mark <= MAX_MARK &&
                !IsIdExists(Map, Id)
            )
            {
                Student S;

                S.Name = Name;
                S.Id = Id;
                S.Mark = Mark;

                Map.insert({
                    S.Name,
                    S
                });
            }
        }
        catch (...)
        {
            continue;
        }
    }

    File.close();

    cout << "\nData Loaded Successfully.\n";
}

// ============================================================
// Export Report
// ============================================================

void ExportReport(
    const StudentMap& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students To Export.\n";
        return;
    }

    ofstream File(
        "student_report.txt"
    );

    if (!File)
    {
        cout << "\nError Creating Report File!\n";
        return;
    }

    int Sum = 0;

    int Passed = 0;
    int Failed = 0;

    int MaxGrade = -1;
    int MinGrade = 1001;

    for (const auto& Pair : Map)
    {
        int Mark =
            Pair.second.Mark;

        Sum += Mark;

        MaxGrade =
            max(MaxGrade, Mark);

        MinGrade =
            min(MinGrade, Mark);

        if (IsPassed(Mark))
            Passed++;
        else
            Failed++;
    }

    double Average =
        static_cast<double>(Sum)
        / Map.size();

    File << "============================================\n";
    File << "          STUDENT MANAGEMENT REPORT\n";
    File << "============================================\n\n";

    File << "Total Students: "
         << Map.size()
         << "\n";

    File << "Total Grades: "
         << Sum
         << "\n";

    File << fixed
         << setprecision(2);

    File << "Average: "
         << Average
         << "\n";

    File << "Median: "
         << CalculateMedian(Map)
         << "\n";

    File << "Highest Grade: "
         << MaxGrade
         << "\n";

    File << "Lowest Grade: "
         << MinGrade
         << "\n";

    File << "Difference: "
         << MaxGrade - MinGrade
         << "\n";

    File << "Passed Students: "
         << Passed
         << "\n";

    File << "Failed Students: "
         << Failed
         << "\n\n";

    File << "============================================\n";
    File << "                STUDENTS\n";
    File << "============================================\n\n";

    for (const auto& Pair : Map)
    {
        const Student& S =
            Pair.second;
        File << "Name: " << S.Name << "\n";
        File << "ID: "
             << S.Id  << "\n";
        File << "Mark: " << S.Mark  << "\n";
        File << "Percentage: " << GetPercentage(S.Mark)
             << "%\n";
        File << "Grade: "
             << GetGradeName(S.Mark)
             << "\n";
        File << "Letter Grade: "
             << GetLetterGrade(S.Mark)
             << "\n";
        File << "Status: "
             << (IsPassed(S.Mark)
                    ? "Passed"
                    : "Failed")
             << "\n";
        File << "--------------------------------------------\n";
    }
    File.close();
    cout << "\nReport Exported Successfully To "
         << "student_report.txt\n";
}
