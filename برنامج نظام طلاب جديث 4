// ============================================================
// Sort Students By Mark
// ============================================================

void SortStudentsByMark(const StudentMap& Map)
{
    if (Map.empty())
    {
        cout << "\nNo Students Found.\n";
        return;
    }

    vector<Student> Students =
        GetStudentsVector(Map);

    cout << "\n=====================================\n";
    cout << "1. Highest To Lowest\n";
    cout << "2. Lowest To Highest\n";
    cout << "=====================================\n";

    int Choice =
        GetValidInteger("Enter Choice: ");

    if (Choice == 1)
    {
        sort(
            Students.begin(),
            Students.end(),
            [](const Student& A, const Student& B)
            {
                return A.Mark > B.Mark;
            }
        );
    }
    else if (Choice == 2)
    {
        sort(
            Students.begin(),
            Students.end(),
            [](const Student& A, const Student& B)
            {
                return A.Mark < B.Mark;
            }
        );
    }
    else
    {
        cout << "Invalid Choice.\n";
        return;
    }

    cout << "\n=====================================\n";
    cout << "        Students Sorted By Mark\n";
    cout << "=====================================\n";

    for (auto S : Students)
    {
        cout << S.Name
             << " | ID: "
             << S.Id
             << " | Mark: "
             << S.Mark
             << " | Grade: "
             << GetGradeName(S.Mark)
             << "\n";
    }
}

// ============================================================
// Calculate Median
// ============================================================

double CalculateMedian(const StudentMap& Map)
{
    vector<Student> Students =
        GetStudentsVector(Map);

    sort(
        Students.begin(),
        Students.end(),
        [](const Student& A, const Student& B)
        {
            return A.Mark < B.Mark;
        }
    );

    int Size = Students.size();

    if (Size % 2 == 1)
    {
        return Students[Size / 2].Mark;
    }

    return (
        Students[Size / 2 - 1].Mark +
        Students[Size / 2].Mark
    ) / 2.0;
}

