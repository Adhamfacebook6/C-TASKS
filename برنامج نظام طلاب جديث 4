// ============================================================
// Add Student
// ============================================================

void AddStudent(StudentMap& Map)
{
    string Name = GetStudentName("\nEnter Student Name: ");

    int Id = GetValidId();

    while (IsIdExists(Map, Id))
    {
        cout << "This ID Already Exists!\n";
        Id = GetValidId();
    }

    int Mark = GetValidMark();

    Map.insert({
        Name,
        {Id, Mark}
    });

    cout << "\nStudent Added Successfully!\n";
}

// ============================================================
// Search By ID
// ============================================================

bool SearchById(
    const StudentMap& Map,
    int SearchId)
{
    for (auto It = Map.begin(); It != Map.end(); ++It)
    {
        if (It->second.first == SearchId)
        {
            cout << "\n=====================================\n";
            cout << "             Student Found\n";
            cout << "=====================================\n";

            DisplayStudent(
                It->first,
                It->second.first,
                It->second.second
            );

            return true;
        }
    }

    return false;
}

// ============================================================
// Search Student By ID
// ============================================================

void SearchStudentById(const StudentMap& Map)
{
    int SearchId = GetValidId();

    if (!SearchById(Map, SearchId))
